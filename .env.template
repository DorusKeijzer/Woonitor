REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

POSTGRES_HOST=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=listing_database

PUSHGATEWAY_URL=

# How often (seconds) queue_metrics.py scans the redis queues to report
# backlog per city to Grafana. Optional, defaults to 30.
QUEUE_METRICS_INTERVAL=30

# Set to "false" to run the scraper/crawler browsers headed (under Xvfb).
# Funda's anti-bot may fingerprint headless Chromium more aggressively; default
# is headless for speed, flip this if you start seeing more captchas/blocks.
PLAYWRIGHT_HEADLESS=true

# Identifies this machine in Prometheus metrics (e.g. "strato_II", "laptop",
# "z800-ts") so per-source graphs in Grafana survive process restarts.
NODE_NAME=

